MEMORY_DB=1
# File-backed local store at api/data/users.json (survives API restarts).
# For MongoDB instead:
# MEMORY_DB=0
# MONGODB_URI=mongodb://127.0.0.1:27017/britbee
JWT_SECRET=britbee-dev-secret-change-me
API_PORT=3001
EXPO_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
HANU_OTP_API_KEY=
HANU_OTP_TEMPLATE_SID=
HANU_OTP_URL=https://api.hanuotp.in/sms-otp.php
# Push popups (Expo Push → FCM Android / APNs iOS). Default ON.
# PUSH_ENABLED=0
# After `eas init` in ./app, paste the project id (also written into app.json extra.eas.projectId):
# EXPO_PUBLIC_EAS_PROJECT_ID=
# Speech uses free Microsoft neural voices (en-GB-SoniaNeural). No key needed.
# EDGE_TTS_VOICE=en-GB-SoniaNeural
# Listening: Chrome dictation mashes short words (bee see → bcs).
# Best free listener: Groq Whisper. Get a key at https://console.groq.com/keys
# GROQ_API_KEY=
# GROQ_WHISPER_MODEL=whisper-large-v3-turbo
# Optional paid upgrade if you later add billing:
OPENAI_API_KEY=

# BritBee Pay (custom UPI / GPay QR gateway for parent shell)
# Mentor GPay / UPI VPA shown on the QR checkout screen:
BILLING_UPI_VPA=britbee@oksbi
BILLING_UPI_NAME=BritBee Mentors
# Optional: host your own QR image instead of the auto-generated UPI QR
# BILLING_UPI_QR_URL=https://cdn.example.com/mentor-gpay-qr.png

# Zoho ZeptoMail — parental email (login alerts, practice reports, class reminders, billing)
# Create a Mail Agent + Send Mail Token: https://www.zoho.com/zeptomail/
# ZEPTOMAIL_TOKEN=  # Send Mail Token (Zoho-enczapikey …) from Agent → SMTP/API
# ZEPTOMAIL_FROM_EMAIL=noreply@your-verified-domain.com
# ZEPTOMAIL_FROM_NAME=BritBee
# Optional India DC: ZEPTOMAIL_API_URL=https://api.zeptomail.in/v1.1/email
# MAIL_ENABLED=0
# MAIL_APP_URL=https://britbee.app
