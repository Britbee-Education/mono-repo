{
  "name": "britbee",
  "private": true,
  "scripts": {
    "dev:api": "pnpm --filter @britbee/api dev",
    "dev:app": "pnpm --filter @britbee/app start",
    "dev:office": "pnpm --filter @britbee/office dev",
    "dev:office:fresh": "pnpm --filter @britbee/office dev:fresh",
    "seed": "pnpm --filter @britbee/api seed",
    "dev:webs": "pnpm --parallel --filter @britbee/office --filter @britbee/api dev",
    "dev:website": "pnpm --filter @britbee/website dev",
    "build:website": "pnpm --filter @britbee/website build",
    "beta:up": "docker compose -f deploy/docker-compose.yml --env-file .env.production up -d --build",
    "beta:down": "docker compose -f deploy/docker-compose.yml --env-file .env.production down",
    "beta:logs": "docker compose -f deploy/docker-compose.yml --env-file .env.production logs -f"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "patchedDependencies": {
      "whatwg-url-without-unicode@8.0.0-3": "patches/whatwg-url-without-unicode@8.0.0-3.patch"
    }
  }
}
