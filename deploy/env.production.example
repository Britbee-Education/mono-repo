# BritBee beta production — copy to repo root as `.env.production`
#   cp deploy/env.production.example .env.production
#
# Stack: AIC Cloud VPS (PM2 + Nginx) · HeavenCloud Mongo · AceCloud object storage
# Docs: deploy/README.md

# --- Public hosts (must match DNS → AIC Cloud VPS) ---
WEBSITE_HOST=britbee.app
API_HOST=api.britbee.app
OFFICE_HOST=office.britbee.app

EXPO_PUBLIC_API_URL=https://api.britbee.app
NEXT_PUBLIC_API_URL=https://api.britbee.app
MAIL_APP_URL=https://britbee.app

# --- Secrets ---
JWT_SECRET=replace-with-long-random-string
MEMORY_DB=0
API_PORT=3001

# HeavenCloud managed MongoDB (Mumbai): https://heavencloud.in/service/database/india
MONGODB_URI=mongodb://USER:PASS@HOST:PORT/britbee?authSource=admin

# AceCloud S3-compatible object storage: https://acecloud.ai/cloud/storage/object/
# (Wire uploads in API when ready; local disk still works for early beta.)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=britbee-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
# S3_PUBLIC_BASE_URL=https://your-bucket-public-url

# OTP / speech / mail
HANU_OTP_API_KEY=
HANU_OTP_TEMPLATE_SID=
HANU_OTP_URL=https://api.hanuotp.in/sms-otp.php
GROQ_API_KEY=
OPENAI_API_KEY=

ZEPTOMAIL_TOKEN=
ZEPTOMAIL_FROM_EMAIL=noreply@britbee.app
ZEPTOMAIL_FROM_NAME=BritBee
# ZEPTOMAIL_API_URL=https://api.zeptomail.in/v1.1/email

BILLING_UPI_VPA=britbee@oksbi
BILLING_UPI_NAME=BritBee Mentors
