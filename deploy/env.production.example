# BritBee production env — copy to repo root as `.env` (API loads ../../.env)
#   cp deploy/env.production.example .env
#
# Names match the running code (api/src, office, app).

# Leave MEMORY_DB=1 until HeavenCloud URI is ready.
MEMORY_DB=1
# MEMORY_DB=0
# MONGODB_URI=mongodb://USER:PASS@HOST:PORT/britbee?authSource=admin

JWT_SECRET=change-me-to-a-long-random-string
API_PORT=3001

# Replace PUBLIC_IP (or domains) before building Office / Expo web
EXPO_PUBLIC_API_URL=https://api.britbee.buzz
NEXT_PUBLIC_API_URL=https://api.britbee.buzz
MAIL_APP_URL=https://britbee.buzz

HANU_OTP_API_KEY=
HANU_OTP_TEMPLATE_SID=
HANU_OTP_URL=https://api.hanuotp.in/sms-otp.php
GROQ_API_KEY=
OPENAI_API_KEY=

ZEPTOMAIL_TOKEN=
ZEPTOMAIL_FROM_EMAIL=noreply@britbee.app
ZEPTOMAIL_FROM_NAME=BritBee

BILLING_UPI_VPA=britbee@oksbi
BILLING_UPI_NAME=BritBee Mentors

# AceCloud object storage (optional until uploads are wired)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=britbee-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
