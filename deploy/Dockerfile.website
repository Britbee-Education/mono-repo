# BritBee marketing site — Vite → nginx static
FROM node:20-bookworm-slim AS builder
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY website/package.json ./website/
RUN pnpm install --filter @britbee/website... --frozen-lockfile
COPY website ./website
RUN pnpm --filter @britbee/website build

FROM nginx:1.27-alpine
COPY --from=builder /app/website/dist /usr/share/nginx/html
COPY deploy/nginx-website.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
